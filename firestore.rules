rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false; 
    }
    
    // SECTIONS (Contains passwords and config)
    match /sections/{sectionId} {
      allow read: if request.auth != null;
      // Prevent users from overwriting crPassword/srPassword. Only allow timetablePublished flag.
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timetablePublished']);
      allow create, delete: if false; 
      
      match /sr_assignments/{assignmentId} {
        allow read, write: if request.auth != null;
      }
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null;
      }
      match /faculty_requests/{requestId} {
        allow read, write: if request.auth != null;
      }
      match /students/{studentId} {
        allow read, write: if request.auth != null;
      }
      match /announcements/{announcementId} {
        allow read, write: if request.auth != null;
      }
      match /history/{historyId} {
        allow read, write: if request.auth != null;
      }
    }

    // FUNCTION: Check if user is CR or SR
    function isCRorSR() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.role in ['CR', 'SR'];
    }

    // OUTBOX FOR RENDER WORKER
    match /notification_outbox/{docId} {
      allow read: if false; // Only backend admin can read
      allow create: if request.auth != null;
      allow update, delete: if false; // Only backend admin can update/delete
    }
    match /faculty_reminders/{docId} {
      allow read, write: if request.auth != null;
    }

    // TIMETABLES
    match /timetables/{sectionId} {
      allow read, write: if request.auth != null;
    }
    match /timetables/{sectionId}/{day}/{lectureId} {
      allow read, write: if request.auth != null;
    }
    
    // ANNOUNCEMENTS (Legacy root rule kept)
    match /announcements/{announcementId} {
      allow read, write: if request.auth != null;
    }
    
    // HISTORY (Legacy root rule kept)
    match /history/{historyId} {
      allow read, write: if request.auth != null;
    }

    // FACULTY PROFILES
    match /faculty_profiles/{profileId} {
      allow read, write: if request.auth != null;
    }

    // FACULTY AUDIT LOGS
    match /faculty_audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    match /faculty_audit_log/{logId} {
      allow read, write: if request.auth != null;
    }

    // USERS (FCM Tokens)
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      match /fcm_tokens/{tokenId} {
        allow read, write: if request.auth != null;
      }
      
      match /attendance/{attendanceId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
