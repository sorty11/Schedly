rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false; 
    }
    
    // SECTIONS (Contains hashed passwords and config)
    match /sections/{sectionId} {
      allow read: if request.auth != null;
      // Prevent users from overwriting crPassword/srPassword. Only allow timetablePublished flag.
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timetablePublished']);
      allow create: if false; // Replaced by Cloud Functions
      allow delete: if false;
      
      match /sr_assignments/{assignmentId} {
        allow read: if request.auth != null;
        allow write: if false; // Replaced by Cloud Functions
      }
      match /notifications/{notificationId} {
        allow read: if request.auth != null;
        allow write: if isCRForSection(sectionId);
      }
      match /faculty_requests/{requestId} {
        allow read: if request.auth != null;
        allow write: if isCRForSection(sectionId);
      }
      match /students/{studentId} {
        allow read, write: if request.auth != null;
      }
      match /announcements/{announcementId} {
        allow read: if request.auth != null;
        allow write: if isCRForSection(sectionId);
      }
      match /history/{historyId} {
        allow read: if request.auth != null;
        allow write: if isCRForSection(sectionId);
      }
      match /analytics/{analyticsId} {
        allow read, write: if request.auth != null;
      }
      match /conduct_logs/{logId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null
                      && request.resource.data.audit.markedByUid == request.auth.uid;
        allow delete: if false;
      }
      match /subjects/{subjectId} {
        allow read: if request.auth != null;
        allow write: if isCRForSection(sectionId);
      }
    }

    // FUNCTION: Check if user is CR or SR
    function isCRorSR() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.role in ['CR', 'SR'];
    }

    // FUNCTION: Check if user is an active CR for a specific section
    function isCRForSection(sectionId) {
      let membershipPath = /databases/$(database)/documents/section_memberships/$(sectionId + '_' + request.auth.uid);
      return exists(membershipPath) 
          && get(membershipPath).data.role == 'CR' 
          && get(membershipPath).data.status == 'active';
    }
    
    // FUNCTION: Check if user is an active SR for a specific section
    function isSRForSection(sectionId) {
      let membershipPath = /databases/$(database)/documents/section_memberships/$(sectionId + '_' + request.auth.uid);
      return exists(membershipPath) 
          && get(membershipPath).data.role == 'SR' 
          && get(membershipPath).data.status == 'active';
    }

    // FUNCTION: Check if user is CR or SR for section
    function isCRorSRForSection(sectionId) {
      return isCRForSection(sectionId) || isSRForSection(sectionId);
    }

    // OUTBOX FOR RENDER WORKER
    match /notification_outbox/{docId} {
      allow read: if false; // Only backend admin can read
      allow create: if request.auth != null;
      allow update, delete: if false; // Only backend admin can update/delete
    }
    match /faculty_reminders/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/faculty_profiles/$(request.auth.uid));
    }

    // DIVISION MEMBERSHIPS
    match /section_memberships/{membershipId} {
      allow read: if request.auth != null;
      // Users can only create their own membership with role 'Student'
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.role == 'Student';
      // Users can only update their own non-critical fields.
      // Roles and statuses are handled by Cloud Functions.
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'userId', 'sectionId']));
    }

    // MEMBERSHIP AUDIT LOGS
    match /membership_audit_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false; // Handled by Cloud Functions
    }

    // TIMETABLES
    match /timetables/{sectionId} {
      allow read: if request.auth != null;
      allow write: if isCRorSRForSection(sectionId);
    }
    match /timetables/{sectionId}/{day}/{lectureId} {
      allow read: if request.auth != null;
      allow write: if isCRorSRForSection(sectionId);
    }
    
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isCRorSR();
    }
    
    match /history/{historyId} {
      allow read: if request.auth != null;
      allow write: if isCRorSR();
    }

    // FACULTY PROFILES
    match /faculty_profiles/{profileId} {
      allow read: if request.auth != null;
      allow write: if false; // Handled by Cloud Functions
    }

    // FACULTY AUDIT LOGS
    match /faculty_audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /faculty_audit_log/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // USERS
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      match /fcm_tokens/{tokenId} {
        allow read, write: if request.auth != null;
      }
      
      match /attendance/{attendanceId} {
        allow read, write: if request.auth != null;
      }
      
      match /attendance_logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
